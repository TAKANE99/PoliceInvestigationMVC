@model IEnumerable<PoliceInvestigationMVC.Models.Evidence>

@{
    ViewData["Title"] = "Evidence for Investigation";
}

<div class="container mt-4 mb-5">

    <div class="card shadow-sm border-0">

        <div class="card-header text-white py-4"
             style="background-color: #102b4e; border-bottom: 4px solid #d4a72c;">

            <h2 class="fw-bold mb-2 text-white">
                <i class="bi bi-folder2-open me-2"></i>
                Evidence for Case @ViewBag.CaseNumber
            </h2>

            <p class="mb-0 text-white">
                View all evidence records associated with this investigation.
            </p>

        </div>

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <p class="text-muted mb-0">
                    Related evidence records
                    </p>
                    <a asp-controller="Evidences"
                    asp-action="Create"
                    class="btn text-white"
                    style="background-color: #102b4e;">
                    <i class="bi bi-plus-circle me-1"></i>
                    Register New Evidence
                </a>
                </div>

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle">

                    <thead style="background-color: #102b4e; color: white;">

                        <tr>
                            <th>Evidence Reference</th>
                            <th>Evidence Type</th>
                            <th>Collection Date</th>
                            <th>Collected By</th>
                            <th>Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.EvidenceReference</td>

                                    <td>@item.EvidenceType</td>

                                    <td>
                                        @item.DateCollected?.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @(item.CollectedBy?.Name ?? "Not available")
                                    </td>

                                    <td>
                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm text-white"
                                           style="background-color: #102b4e;">

                                            <i class="bi bi-eye me-1"></i>
                                            Details

                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    No evidence has been registered for this investigation yet.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <a asp-controller="Investigations"
               asp-action="Details"
               asp-route-id="@ViewBag.InvestigationId"
               class="btn btn-outline-secondary mt-3">

                Back to Investigation

            </a>

        </div>

    </div>

</div>