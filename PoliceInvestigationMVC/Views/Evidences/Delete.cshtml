@model PoliceInvestigationMVC.Models.Evidence

@{
    ViewData["Title"] = "Delete Evidence";
}

<div class="container mt-4 mb-5">

    <div class="card shadow border-0">

        <div class="card-header text-white py-3"
             style="background-color: #102b4e; border-bottom: 4px solid #d4a72c;">

            <h3 class="mb-2 text-white"
                style="font-weight: bold;">
                <i class="bi bi-trash me-2"></i>
                Delete Evidence Record
            </h3>

            <small>Review the evidence information before deletion.</small>
        </div>

        <div class="card-body p-4">

            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle me-2"></i>
                <strong>Warning!</strong>
                Are you sure you want to permanently delete this evidence record?
            </div>

            <div class="alert alert-light border mb-4">
                <strong>Evidence Reference:</strong>
                <span class="ms-2 text-primary">
                    @Model.EvidenceReference
                </span>
            </div>

            <h5 class="mb-3" style="color: #102b4e;">
                Evidence Information
            </h5>

            <div class="row mb-3">
                <div class="col-md-3 fw-bold">Description</div>
                <div class="col-md-9">@Model.Description</div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3 fw-bold">Evidence Type</div>
                <div class="col-md-9">@Model.EvidenceType</div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3 fw-bold">Collection Date</div>
                <div class="col-md-9">
                    @Model.DateCollected?.ToString("dd MMM yyyy")
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3 fw-bold">Collected By</div>
                <div class="col-md-9">
                    @(Model.CollectedBy?.Name ?? "Not available")
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3 fw-bold">Storage Location</div>
                <div class="col-md-9">@Model.StorageLocation</div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3 fw-bold">Investigation</div>
                <div class="col-md-9">
                    @(Model.Investigation?.CaseNumber ?? "Not available")
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3 fw-bold">Chain of Custody</div>
                <div class="col-md-9">@Model.ChainOfCustody</div>
            </div>

            @if (!string.IsNullOrEmpty(Model.FileName))
            {
                <div class="row mb-3">
                    <div class="col-md-3 fw-bold">Uploaded File</div>
                    <div class="col-md-9">@Model.FileName</div>
                </div>
            }

            <hr />

            <form asp-action="Delete" method="post">

                <input type="hidden" asp-for="Id" />

                <button type="submit"
                        class="btn btn-danger px-4">
                    <i class="bi bi-trash me-1"></i>
                    Confirm Delete
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary px-4 ms-2">
                    <i class="bi bi-arrow-left me-1"></i>
                    Back to Evidence List
                </a>

            </form>

        </div>
    </div>
</div>
