@model PoliceInvestigationMVC.Models.Evidence

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Evidence</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
    
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.EvidenceType)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.EvidenceType)
        </dd>
  
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.InvestigationId)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.InvestigationId)
        </dd>
  
        <dt class = "col-sm-2">
            Investigation
        </dt>
        <dd class = "col-sm-10">
            @(Model.Investigation?.CaseNumber ?? "Not Linked")
        </dd>
   
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
