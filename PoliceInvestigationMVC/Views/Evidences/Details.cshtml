@model PoliceInvestigationMVC.Models.Evidence

@{
    ViewData["Title"] = "Evidence Details";
}

<div class="container mt-4 mb-5">

    <div class="card shadow">

        <div class="card-header text-white"
             style="background-color: #102b4e; padding: 25px;">
            <h1 style="color: white; font-size: 2rem; font-weight: bold;">
                Evidence Details
            </h1>
            <p style="color: white; margin-bottom: 0;">
                Complete evidence information and chain of custody record.
            </p>
        </div>

        <div class="card-body p-4">

            <div class="alert alert-info">
                <strong>Evidence Reference:</strong>
                @Model.EvidenceReference
            </div>

            <h5 style="color: #102b4e; font-weight: bold;">
                General Evidence Information
            </h5>

            <div class="row mb-3">
                <div class="col-md-3">
                    <strong>Crime Category</strong>
                    </div>
                    <div class="col-md-9">
                        @(Model.Investigation?.CrimeCategory ?? "Not available")
                        </div>
                        </div>

            <dl class="row mt-3">

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Description</dd>

                <dt class="col-sm-3">Evidence Type</dt>
                <dd class="col-sm-9">@Model.EvidenceType</dd>

                <dt class="col-sm-3">Collection Date</dt>
                <dd class="col-sm-9">
                    @(Model.DateCollected?.ToString("dd MMMM yyyy") ?? "Not recorded")
                </dd>

                <dt class="col-sm-3">Collected By</dt>
                <dd class="col-sm-9">
                    @(Model.CollectedBy?.Name ?? "Not assigned")
                </dd>

                <dt class="col-sm-3">Storage Location</dt>
                <dd class="col-sm-9">@Model.StorageLocation</dd>

                <dt class="col-sm-3">Investigation</dt>
                <dd class="col-sm-9">
                    @(Model.Investigation?.CaseNumber ?? "Not linked")
                </dd>

            </dl>

            <hr />

            <h5 style="color: #102b4e; font-weight: bold;">
                Chain of Custody
            </h5>

            <div class="border rounded p-3 mt-3"
                 style="background-color: #f4f6f9; white-space: pre-wrap;">@Model.ChainOfCustody</div>

            <hr />

            <h5 style="color: #102b4e; font-weight: bold;">
                Evidence Attachments
                </h5>

                <div class="border rounded p-3 mt-3"
                style="background-color: #f4f6f9;">

                @if (Model.EvidenceFiles != null && Model.EvidenceFiles.Any())
                {
                    <p class="text-muted">
                        Total uploaded files: @Model.EvidenceFiles.Count
                    </p>

                   <div class="list-group">
                       @foreach (var file in Model.EvidenceFiles)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">

                                    <div>
                                        <strong>@file.FileName</strong>
                                        <br />
                                        <small class="text-muted">
                                            Uploaded: @file.DateUploaded.ToString("dd MMMM yyyy HH:mm")
                                       </small>
                                     </div>
                                     
                                     <a asp-action="DownloadAttachment"
                                     asp-route-fileId="@file.Id"
                                     class="btn btn-success btn-sm">
                                     Download File
                                    </a>

                                </div>
                                }
                                </div>
                                }
                                else
                                {
                                    <p class="text-muted mb-0">
                                        No additional evidence attachments have been uploaded.
                                        </p>
                                }

                                @* Displays any files uploaded using the previous single-file system. *@
                                @if (!string.IsNullOrEmpty(Model.FilePath))
                                {
                                    <hr />
                                    <strong>Previously Uploaded File:</strong>
                                    <p>@Model.FileName</p>

                                    <a asp-action="Download"
                                    asp-route-id="@Model.Id"
                                    class="btn btn-outline-success btn-sm">
                                    Download Previous File
                                </a>
                                }
                                </div>

                              <hr />

                             <div class="mt-4"> 
                                 <a asp-action="Edit"
                                 asp-route-id="@Model.Id"
                                 class="btn text-white"
                                 style="background-color: #102b4e;">
                                 Edit Evidence
                             </a>

                             <a asp-action="Index"
                             class="btn btn-secondary ms-2">
                             Back to Evidence List
                         </a>
            </div>

        </div>
    </div>
</div>
