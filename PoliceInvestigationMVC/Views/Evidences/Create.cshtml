@model PoliceInvestigationMVC.Models.Evidence

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Evidence</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="EvidenceType" class="control-label"></label>
                <input asp-for="EvidenceType" class="form-control" />
                <span asp-validation-for="EvidenceType" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label for="evidenceFile" class="control-label">
                    Upload Evidence Photo or Document
                </label>
                <input type="file"
                       id="evidenceFile"
                       name="evidenceFile"
                       class="form-control"
                       accept=".jpg,.jpeg,.png,.pdf,.doc,.docx" />
            </div>
            
            <div class="form-group">
                <label asp-for="InvestigationId" class="control-label">
                    Investigation
                </label>
                <select asp-for="InvestigationId"
                        class="form-control"
                        asp-items="ViewBag.InvestigationId">
                    <option value="">-- Select Investigation --</option>
                </select>
                <span asp-validation-for="InvestigationId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
                 <a asp-action="Index">Back to List</a>
            </div>
        </form>
    </div>
</div>


