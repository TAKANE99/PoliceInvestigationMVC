@model IEnumerable<PoliceInvestigationMVC.Models.InvestigationSuspect>

@{
    ViewData["Title"] = "Investigation Suspects";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 style="color: #102b4e; font-weight: bold;">
                Investigation Suspects
            </h2>
            <p class="text-muted">
                Manage persons suspected of involvement in investigations.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            Register Suspect
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="d-flex justify-content-end mb-3">
                <form asp-action="Index" method="get"
                style="width: 500px; max-width: 100%;">

                <div class="input-group">
                    <input type="text"
                        name="searchString"
                        value="@ViewData["CurrentFilter"]"
                        class="form-control"
                        placeholder="Search by suspect name, ID number or case number..." />

                        <button type="submit" class="btn text-white"
                        style="background-color: #102b4e;">
                        Search
                    </button>

                    <a asp-action="Index"
                    class="btn btn-secondary">
                    Clear
                    </a>
                </div>
             </form>
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle">

                        <thead style="background-color: #102b4e; color: white;">
                            <tr>
                                <th>Full Name</th>
                                <th>ID Number</th>
                                <th>Investigation</th>
                                <th>Identification Status</th>
                                <th>Arrest Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var suspect in Model)
                            {
                                <tr>
                                    <td>
                                        @(string.IsNullOrWhiteSpace(suspect.FullName)
                                            ? "Unknown"
                                            : suspect.FullName)
                                    </td>

                                    <td>@(suspect.IDNumber ?? "Not available")</td>

                                    <td>
                                        @(suspect.Investigation?.CaseNumber ?? "Not available")
                                    </td>

                                    <td>@suspect.IdentificationStatus</td>

                                    <td>@suspect.ArrestStatus</td>

                                    <td>
                                        <a asp-action="Details"
                                           asp-route-id="@suspect.Id"
                                           class="btn btn-sm btn-info">
                                            Details
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@suspect.Id"
                                           class="btn btn-sm btn-warning">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@suspect.Id"
                                           class="btn btn-sm btn-danger">
                                            Delete
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    No suspects have been registered yet.
                </div>
            }

        </div>
    </div>
</div>
