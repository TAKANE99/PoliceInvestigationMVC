@model IEnumerable<PoliceInvestigationMVC.Models.InvestigationSuspect>

@{
    ViewData["Title"] = "Investigation Suspects";
}

<div class="container mt-4 mb-5">

    <div class="card shadow-sm border-0">

        <div class="card-header text-white py-4"
             style="background-color: #102b4e; border-bottom: 4px solid #d4a72c;">

            <h2 class="fw-bold text-white mb-2">
                Investigation Suspects
            </h2>

            <p class="mb-0 text-white">
                Suspects linked to Case: @ViewBag.CaseNumber
            </p>
        </div>

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <h5 class="fw-bold" style="color: #102b4e;">
                    Related Suspects
                </h5>

                <a asp-controller="InvestigationSuspects"
                   asp-action="Create"
                   asp-route-investigationId="@ViewBag.InvestigationId"
                   class="btn text-white"
                   style="background-color: #102b4e;">
                    <i class="bi bi-person-plus me-1"></i>
                    Register Suspect
                </a>

            </div>

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-bordered table-hover align-middle">

                        <thead style="background-color: #102b4e; color: white;">
                            <tr>
                                <th>Full Name</th>
                                <th>ID Number</th>
                                <th>Identification Status</th>
                                <th>Arrest Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var suspect in Model)
                            {
                                <tr>
                                    <td>@(suspect.FullName ?? "Unknown")</td>

                                    <td>@(suspect.IDNumber ?? "Not available")</td>

                                    <td>@suspect.IdentificationStatus</td>

                                    <td>@suspect.ArrestStatus</td>

                                    <td>
                                        <a asp-action="Details"
                                           asp-route-id="@suspect.Id"
                                           class="btn btn-info btn-sm">
                                            Details
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@suspect.Id"
                                           class="btn btn-warning btn-sm">
                                            Edit
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="alert alert-info">
                    No suspects have been registered for this investigation yet.
                </div>
            }

            <hr />

            <a asp-controller="Investigations"
               asp-action="Details"
               asp-route-id="@ViewBag.InvestigationId"
               class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back to Investigation
            </a>

        </div>
    </div>
</div>