<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PoliceInvestigationMVC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PoliceInvestigationMVC.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    <img src="~/images/saps-logo.jpg"
                         alt="SAPS Logo"
                         class="saps-logo me-2" />

                    PoliceInvestigationMVC
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-xxl-inline-flex justify-content-between"
                     id="mainNavigation">
                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Index">Home</a>
                        </li>

                        @if (User.IsInRole("Administrator"))
                        {
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="PoliceStations"
                               asp-action="Index">Police Stations</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="PoliceOfficers"
                               asp-action="Index">Police Officers</a>
                        </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Investigations"
                               asp-action="Index">Investigations</a>
                        </li>

                        @*
                        @if (User.IsInRole("PoliceOfficer"))
                        {
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Evidences"
                               asp-action="Index">Evidence</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Witnesses"
                               asp-action="Index">Witnesses</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                            asp-controller="InvestigationSuspects"
                            asp-action="Index">
                            Suspects
                        </a>
                        </li>
                        }
                       
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="InvestigationOfficers"
                               asp-action="Index">
                                Investigation Teams
                            </a>
                        </li>
                        
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="CaseReviews"
                               asp-action="Index">
                                Case Reviews
                            </a>
                        </li>
                        *@
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Privacy">Privacy</a>
                        </li>
                        
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - PoliceInvestigationMVC - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
