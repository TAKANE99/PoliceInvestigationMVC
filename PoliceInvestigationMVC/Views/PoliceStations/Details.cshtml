@model PoliceInvestigationMVC.Models.PoliceStation

@{
    ViewData["Title"] = "Police Station Details";
}

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Police Station Details</h1>
            <p class="text-muted">Official police station information and records.</p>
        </div>
        <span class="badge bg-primary fs-6">Station Profile</span>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-header text-white p-4"
             style="background-color: #102b4e; border-top: 5px solid #d4a72c;">

            <h3 class="mb-1" style="color: white;">@Model.Name</h3>

            <p class="mb-0">Station Code: @Model.StationCode</p>

        </div>

        <div class="card-body p-4">

            <h4 class="mb-4">General Information</h4>

            <div class="row g-4">

                <div class="col-md-6">
                    <label class="text-muted">Station Name</label>
                    <h5>@Model.Name</h5>
                </div>

                <div class="col-md-6">
                    <label class="text-muted">Station Code</label>
                    <h5>@Model.StationCode</h5>
                </div>

                <div class="col-md-12">
                    <label class="text-muted">Physical Address</label>
                    <h5>@Model.Location</h5>
                </div>

                <div class="col-md-6">
                    <label class="text-muted">Province</label>
                    <h5>@Model.Province</h5>
                </div>

                <div class="col-md-6">
                    <label class="text-muted">Contact Number</label>
                    <h5>@Model.ContactNumber</h5>
                </div>

                <div class="col-md-12">
                    <label class="text-muted">Station Commander</label>
                    <h5>@Model.StationCommander</h5>
                </div>

            </div>

            <hr class="my-4" />

            <h4 class="mb-3">Station Personnel</h4>

@if (Model.PoliceOfficers != null && Model.PoliceOfficers.Any())
{
    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead style="background-color: #102b4e; color: white;">
                <tr>
                    <th>Officer Name</th>
                    <th>Rank</th>
                    <th>Service Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var officer in Model.PoliceOfficers)
                {
                    <tr>
                        <td>@officer.Name</td>
                        <td>@officer.Rank</td>
                        <td>
                            <span class="badge bg-success">Registered</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        No police officers are currently registered under this station.
    </div>
}

            <hr class="my-4" />

            <!-- Station navigation buttons -->
            <div class="d-flex gap-2 flex-wrap">

                <a asp-controller="PoliceOfficers"
                   asp-action="Index"
                   asp-route-stationId="@Model.Id"
                   class="btn btn-dark">
                    View All Station Officers
                </a>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Back to Stations
                </a>

            </div>


        </div>
    </div>
</div>
