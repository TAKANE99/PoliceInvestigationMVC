@model PoliceInvestigationMVC.Models.PoliceStation

@{
    ViewData["Title"] = "Register Police Station";
}

<div class="station-form-page">

    <h1>Register Police Station</h1>
    <p class="text-muted">
        Enter the official information for the new police station.
    </p>

    <div class="card shadow-sm mt-4">
        <div class="card-header">
            <h4>Police Station Information</h4>
        </div>

        <div class="card-body">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="form-label">
                            Station Name
                        </label>
                        <input asp-for="Name"
                               class="form-control"
                               placeholder="e.g. Mamelodi Police Station" />
                        <span asp-validation-for="Name"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="StationCode" class="form-label">
                            Station Code
                        </label>
                        <input asp-for="StationCode"
                               class="form-control"
                               placeholder="Enter station code" />
                        <span asp-validation-for="StationCode"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-12 mb-3">
                        <label asp-for="Location" class="form-label">
                            Physical Address
                        </label>
                        <textarea asp-for="Location"
                                  class="form-control"
                                  rows="2"
                                  placeholder="Enter full physical address"></textarea>
                        <span asp-validation-for="Location"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Province" class="form-label">
                            Province
                        </label>
                        <select asp-for="Province" class="form-select">
                            <option value="">Select Province</option>
                            <option value="Eastern Cape">Eastern Cape</option>
                            <option value="Free State">Free State</option>
                            <option value="Gauteng">Gauteng</option>
                            <option value="KwaZulu-Natal">KwaZulu-Natal</option>
                            <option value="Limpopo">Limpopo</option>
                            <option value="Mpumalanga">Mpumalanga</option>
                            <option value="Northern Cape">Northern Cape</option>
                            <option value="North West">North West</option>
                            <option value="Western Cape">Western Cape</option>
                        </select>
                        <span asp-validation-for="Province"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="ContactNumber" class="form-label">
                            Contact Number
                        </label>
                        <input asp-for="ContactNumber"
                               class="form-control"
                               type="tel"
                               maxlength="10"
                               placeholder="e.g. 0123456789" />
                        <span asp-validation-for="ContactNumber"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-12 mb-3">
                        <label asp-for="StationCommander" class="form-label">
                            Station Commander
                        </label>
                        <input asp-for="StationCommander"
                               class="form-control"
                               placeholder="Enter station commander's full name" />
                        <span asp-validation-for="StationCommander"
                              class="text-danger"></span>
                    </div>

                </div>

                <hr />

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-gold">
                        Save Police Station
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        Back to Stations
                    </a>
                </div>

            </form>

        </div>
    </div>
</div>

<style>
    .station-form-page h1 {
        color: #102b4e;
        font-size: 2.5rem;
        font-weight: 600;
    }

    .station-form-page .card {
        border: none;
        border-top: 5px solid #d4a72c;
        border-radius: 8px;
    }

    .station-form-page .card-header {
        background-color: #102b4e;
        color: white;
        padding: 18px;
    }

    .station-form-page .card-header h4 {
        margin: 0;
    }

    .station-form-page .form-label {
        color: #102b4e;
        font-weight: 600;
    }

    .station-form-page .form-control,
    .station-form-page .form-select {
        padding: 11px;
        border: 1px solid #ced4da;
    }

    .station-form-page .form-control:focus,
    .station-form-page .form-select:focus {
        border-color: #d4a72c;
        box-shadow: 0 0 0 0.15rem rgba(212, 167, 44, 0.2);
    }

    .station-form-page .btn-gold {
        background-color: #d4a72c;
        color: #102b4e;
        border: none;
        font-weight: 600;
        padding: 10px 20px;
    }

    .station-form-page .btn-gold:hover {
        background-color: #b88d1e;
        color: white;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}