@model PoliceInvestigationMVC.Models.PoliceStation

@{
    ViewData["Title"] = "Delete Police Station";
}

<div class="container py-4">

    <div class="mb-4">
        <h1 style="color: #102b4e; font-weight: 700;">
            Delete Police Station
        </h1>
        <p class="text-muted">
            Review the police station information before confirming deletion.
        </p>
    </div>

    <div class="card shadow-sm border-0"
         style="border-top: 6px solid #d4a72c !important; border-radius: 12px;">

        <div class="card-body p-4">

            <div class="alert alert-warning mb-4">
                <strong>Warning!</strong>
                Are you sure you want to delete this police station?
                This action cannot easily be undone.
            </div>

            <h3 class="mb-4" style="color: #102b4e;">
                Police Station Information
            </h3>

            <div class="row g-4">

                <div class="col-md-6">
                    <label class="text-muted">Station Name</label>
                    <div class="fs-5">@Model.Name</div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted">Station Code</label>
                    <div class="fs-5">@Model.StationCode</div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted">Physical Address</label>
                    <div class="fs-5">@Model.Location</div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted">Province</label>
                    <div class="fs-5">@Model.Province</div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted">Contact Number</label>
                    <div class="fs-5">@Model.ContactNumber</div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted">Station Commander</label>
                    <div class="fs-5">@Model.StationCommander</div>
                </div>

            </div>

            <hr class="my-4" />

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />

                <button type="submit" class="btn btn-danger px-4">
                    Delete Police Station
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary ms-2 px-4">
                    Back to Stations
                </a>
            </form>

        </div>
    </div>
</div>