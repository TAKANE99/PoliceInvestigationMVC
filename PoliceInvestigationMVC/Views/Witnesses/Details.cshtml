@model PoliceInvestigationMVC.Models.Witness

@{
    ViewData["Title"] = "Witness Details";
}

<div class="container mt-4 mb-5">

    <div class="card shadow border-0">

        <div class="card-header text-white py-3"
             style="background-color: #102b4e; border-bottom: 4px solid #d4a72c;">

            <h2 class="mb-2 text-white fw-bold">
                <i class="bi bi-person-lines-fill me-2"></i>
                Witness Details
            </h2>

            <p class="mb-0 text-white">
                View registered witness information and their recorded statement.
            </p>

        </div>

        <div class="card-body p-4">

            <div class="alert alert-light border mb-4">
                <strong>Witness Name:</strong>
                <span class="ms-2 text-primary fw-semibold">
                    @Model.Name
                </span>
            </div>

            <div class="row">

                <div class="col-md-6 mb-4">
                    <label class="form-label fw-bold">Full Name</label>
                    <div class="form-control bg-light">
                        @Model.Name
                    </div>
                </div>

                <div class="col-md-6 mb-4">
                    <label class="form-label fw-bold">Contact Details</label>
                    <div class="form-control bg-light">
                        @Model.ContactInformation
                    </div>
                </div>

                <div class="col-md-6 mb-4">
                    <label class="form-label fw-bold">Statement Date</label>
                    <div class="form-control bg-light">
                        @Model.StatementDate.ToString("dd MMMM yyyy")
                    </div>
                </div>

                <div class="col-md-6 mb-4">
                    <label class="form-label fw-bold">Associated Case</label>
                    <div class="form-control bg-light">
                        @(Model.Investigation?.CaseNumber ?? "Not linked")
                    </div>
                </div>

                <div class="col-12 mb-4">
                    <label class="form-label fw-bold">Witness Statement</label>
                    <div class="form-control bg-light"
                         style="min-height: 150px; white-space: pre-wrap;">@Model.Statement</div>
                </div>

            </div>

            <hr />

            <div class="d-flex gap-2">

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn text-white px-4"
                   style="background-color: #102b4e;">
                    <i class="bi bi-pencil-square me-1"></i>
                    Edit Witness
                </a>

                <a asp-action="Index"
                   class="btn btn-secondary px-4">
                    <i class="bi bi-arrow-left me-1"></i>
                    Back to Witness List
                </a>

            </div>

        </div>
    </div>
</div>
