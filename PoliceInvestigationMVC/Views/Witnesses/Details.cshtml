@model PoliceInvestigationMVC.Models.Witness

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Witness</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
    
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ContactInformation)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ContactInformation)
        </dd>
   
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Statement)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Statement)
        </dd>

        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.InvestigationId)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.InvestigationId)
        </dd>
   
        <dt class = "col-sm-2">
            Investigations
        </dt>
        <dd class = "col-sm-10">
            @(Model.Investigation?.CaseNumber ?? "Not linked")
        </dd>
  
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
