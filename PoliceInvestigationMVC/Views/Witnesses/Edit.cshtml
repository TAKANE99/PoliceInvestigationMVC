@model PoliceInvestigationMVC.Models.Witness

@{
    ViewData["Title"] = "Edit Witness";
}

<div class="container mt-4 mb-5">

    <div class="card shadow border-0">

        <div class="card-header text-white py-4"
             style="background-color: #102b4e; border-bottom: 4px solid #d4a72c;">

            <h2 class="mb-2 fw-bold" style="color: white;">Edit Witness Record</h2>

            <p class="mb-0">
                Update witness information and their recorded statement.
            </p>
        </div>

        <div class="card-body p-4">

            <form asp-action="Edit" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <input type="hidden" asp-for="Id" />

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="form-label fw-bold">
                            Full Name
                        </label>
                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Enter witness full name" />
                        <span asp-validation-for="Name"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="ContactInformation"
                               class="form-label fw-bold">
                            Contact Details
                        </label>
                        <input asp-for="ContactInformation"
                               class="form-control"
                               placeholder="Enter contact details" />
                        <span asp-validation-for="ContactInformation"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="StatementDate"
                               class="form-label fw-bold">
                            Statement Date
                        </label>
                        <input asp-for="StatementDate"
                               type="date"
                               class="form-control" />
                        <span asp-validation-for="StatementDate"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="InvestigationId"
                               class="form-label fw-bold">
                            Associated Case
                        </label>
                        <select asp-for="InvestigationId"
                                class="form-select"
                                asp-items="ViewBag.InvestigationId">
                            <option value="">-- Select Associated Case --</option>
                        </select>
                        <span asp-validation-for="InvestigationId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12 mb-3">
                        <label asp-for="Statement"
                               class="form-label fw-bold">
                            Witness Statement
                        </label>
                        <textarea asp-for="Statement"
                                  class="form-control"
                                  rows="6"
                                  placeholder="Enter the witness statement..."></textarea>
                        <span asp-validation-for="Statement"
                              class="text-danger"></span>
                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn text-white px-4"
                            style="background-color: #102b4e;">
                        <i class="bi bi-save me-1"></i>
                        Save Changes
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary px-4">
                        <i class="bi bi-arrow-left me-1"></i>
                        Back to Witness List
                    </a>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
