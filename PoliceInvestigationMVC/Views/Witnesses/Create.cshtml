@model PoliceInvestigationMVC.Models.Witness

@{
    ViewData["Title"] = "Register Witness";
}

<div class="container mt-4 mb-5">

    <div class="card shadow border-0">

        <div class="card-header text-white py-3"
             style="background-color: #102b4e; border-bottom: 4px solid #d4a72c;">

            <h3 class="mb-2 text-white fw-bold">
                <i class="bi bi-person-plus me-2"></i>
                Register New Witness
            </h3>

            <p class="mb-0">
                Capture witness details and record their statement.
            </p>
        </div>

        <div class="card-body p-4">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="Name"
                               class="form-label fw-bold"></label>
                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Enter witness full name" />
                        <span asp-validation-for="Name"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="ContactInformation"
                               class="form-label fw-bold"></label>
                        <input asp-for="ContactInformation"
                               class="form-control"
                               placeholder="Enter contact details" />
                        <span asp-validation-for="ContactInformation"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="InvestigationId"
                               class="form-label fw-bold"></label>
                        <select asp-for="InvestigationId"
                                class="form-select"
                                asp-items="ViewBag.InvestigationId">
                            <option value="">-- Select Associated Case --</option>
                        </select>
                        <span asp-validation-for="InvestigationId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12 mb-3">
                        <label asp-for="Statement"
                               class="form-label fw-bold"></label>
                        <textarea asp-for="Statement"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Enter the witness statement..."></textarea>
                        <span asp-validation-for="Statement"
                              class="text-danger"></span>
                    </div>

                </div>

                <hr />

                <button type="submit"
                        class="btn text-white px-4"
                        style="background-color: #102b4e;">
                    <i class="bi bi-save me-1"></i>
                    Register Witness
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary px-4 ms-2">
                    <i class="bi bi-arrow-left me-1"></i>
                    Back to Witness List
                </a>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}