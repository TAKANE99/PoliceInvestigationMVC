@model PoliceInvestigationMVC.Models.Witness

@{
    ViewData["Title"] = "Delete Witness";
}

<div class="container mt-4 mb-5">

    <div class="card shadow border-0">

        <div class="card-header text-white py-4"
             style="background-color: #102b4e; border-bottom: 4px solid #d4a72c;">

            <h2 class="mb-2 fw-bold" style="color: white;">
                Delete Witness Record
            </h2>

            <p class="mb-0">
                Review the witness information before deleting this record.
            </p>
        </div>

        <div class="card-body p-4">

            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <strong>Warning:</strong>
                Are you sure you want to permanently delete this witness record?
            </div>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Full Name</label>
                    <input class="form-control"
                           value="@Model.Name"
                           readonly />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Contact Details</label>
                    <input class="form-control"
                           value="@Model.ContactInformation"
                           readonly />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Statement Date</label>
                    <input class="form-control"
                           value="@Model.StatementDate.ToString("dd MMMM yyyy")"
                           readonly />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Associated Case</label>
                    <input class="form-control"
                           value="@(Model.Investigation?.CaseNumber ?? "Not linked")"
                           readonly />
                </div>

                <div class="col-12 mb-3">
                    <label class="form-label fw-bold">Witness Statement</label>
                    <textarea class="form-control"
                              rows="6"
                              readonly>@Model.Statement</textarea>
                </div>

            </div>

            <hr class="my-4" />

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-danger px-4">
                        <i class="bi bi-trash me-1"></i>
                        Delete Witness
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary px-4">
                        <i class="bi bi-arrow-left me-1"></i>
                        Back to Witness List
                    </a>

                </div>
            </form>

        </div>
    </div>
</div>