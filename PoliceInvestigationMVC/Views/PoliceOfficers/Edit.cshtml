@model PoliceInvestigationMVC.Models.PoliceOfficer

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>PoliceOfficer</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Rank" class="control-label"></label>
                <input asp-for="Rank" class="form-control" />
                <span asp-validation-for="Rank" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StationId" class="control-label">Police Station</label>
                <select asp-for="StationId"
                        class="form-control"
                        asp-items="ViewBag.StationId">
                    <option value="">-- Select Police Station --</option>
                </select>
                <span asp-validation-for="StationId" class="text-danger"></span>
            </div>

            <div class="d-flex align-items-center gap-2">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-link">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
