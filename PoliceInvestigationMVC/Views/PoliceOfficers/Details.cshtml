@model PoliceInvestigationMVC.Models.PoliceOfficer

@{
    ViewData["Title"] = "Police Officer Details";
}

<div class="container-fluid py-4">

    <!-- Page Heading -->
    <div class="mb-4">
        <h1 style="color: #102b4e; font-weight: 600;">
            Police Officer Details
        </h1>
        <p class="text-muted">
            View the registered police officer's information.
        </p>
    </div>

    <!-- Officer Details Card -->
    <div class="card shadow-sm border-0"
         style="border-top: 5px solid #d4a72c !important; border-radius: 10px;">

        <div class="card-body p-4">

            <h3 class="mb-4" style="color: #102b4e;">
                Officer Information
            </h3>

            <div class="row">

                <div class="col-md-6 mb-4">
                    <label class="text-muted fw-semibold">Service Number</label>
                    <div class="fs-5">@Model.ServiceNumber</div>
                </div>

                <div class="col-md-6 mb-4">
                    <label class="text-muted fw-semibold">Full Name</label>
                    <div class="fs-5">@Model.Name</div>
                </div>

                <div class="col-md-6 mb-4">
                    <label class="text-muted fw-semibold">Rank</label>
                    <div class="fs-5">@Model.Rank</div>
                </div>

                <div class="col-md-6 mb-4">
                    <label class="text-muted fw-semibold">Assigned Police Station</label>
                    <div class="fs-5">
                        @(Model.Station?.Name ?? "No station assigned")
                    </div>
                </div>

                <div class="col-md-6 mb-4">
                    <label class="text-muted fw-semibold">Contact Number</label>
                    <div class="fs-5">@Model.ContactNumber</div>
                </div>

                <div class="col-md-6 mb-4">
                    <label class="text-muted fw-semibold">Email Address</label>
                    <div class="fs-5">@Model.Email</div>
                </div>

                <div class="col-md-6 mb-4">
                    <label class="text-muted fw-semibold">Employment Status</label>
                    <div>
                        @if (Model.EmploymentStatus == "Active")
                        {
                            <span class="badge bg-success fs-6">
                                @Model.EmploymentStatus
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary fs-6">
                                @Model.EmploymentStatus
                            </span>
                        }
                    </div>
                </div>

            </div>

            <hr />

            <div class="d-flex gap-2">
                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn"
                   style="background-color: #d4a72c; color: #102b4e;">
                    Edit Officer
                </a>

                <a asp-controller="Investigations"
                   asp-action="Index"
                   asp-route-officerId="@Model.Id"
                   class="btn btn-dark">
                    View Investigations
                </a>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Back to Officers
                </a>
            </div>

        </div>
    </div>
</div>
