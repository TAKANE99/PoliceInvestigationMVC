@model PoliceInvestigationMVC.Models.Investigation

@{
    ViewData["Title"] = "Investigation Details";
}

<div class="container mt-4 mb-5">

    <div class="card shadow-sm border-0">

        <!-- Page Header -->
        <div class="card-header text-white py-4"
             style="background-color: #102b4e; border-bottom: 4px solid #d4a72c;">

            <h2 class="mb-2 fw-bold text-white">
                Investigation Details
                </h2>
                <p class="mb-0 text-white">
                    South African Police Service - Case Management
                    </p>
                    </div>

        <div class="card-body p-4">

            <!-- Case Information -->
            <h5 class="fw-bold mb-3" style="color: #102b4e;">
                <i class="bi bi-folder-fill me-2"></i>
                Case Information
            </h5>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <strong>Case Number</strong>
                    <p class="text-muted">@Model.CaseNumber</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>CAS Number</strong>
                    <p class="text-muted">@Model.CASNumber</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Complainant</strong>
                    <p class="text-muted">@Model.Complainant</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Crime Category</strong>
                    <p class="text-muted">@Model.CrimeCategory</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Investigation Title</strong>
                    <p class="text-muted">@Model.Title</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Case Type</strong>
                    <p class="text-muted">@Model.CaseType</p>
                </div>

            </div>

            <hr />

            <!-- Investigation Description -->
            <h5 class="fw-bold mb-3" style="color: #102b4e;">
                Investigation Description
            </h5>

            <div class="p-3 rounded mb-3"
                 style="background-color: #f4f6f9; border-left: 4px solid #d4a72c;">

                <p class="mb-0 text-muted">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "No investigation description provided."
                        : Model.Description)
                </p>

            </div>

            <hr />

            <!-- Investigation Assignment -->
            <h5 class="fw-bold mb-3" style="color: #102b4e;">
                Investigation Assignment
            </h5>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <strong>Investigating Officer</strong>
                    <p class="text-muted">
                        @(Model.InvestigatingOfficer?.Name ?? "Not assigned")
                    </p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Priority</strong>
                    <p>
                        @if (Model.Priority == "Critical")
                        {
                            <span class="badge bg-danger">Critical</span>
                        }
                        else if (Model.Priority == "High")
                        {
                            <span class="badge bg-warning text-dark">High</span>
                        }
                        else if (Model.Priority == "Medium")
                        {
                            <span class="badge bg-info text-dark">Medium</span>
                        }
                        else
                        {
                            <span class="badge bg-success">@Model.Priority</span>
                        }
                    </p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Case Status</strong>
                    <p>
                        @if (Model.Status == "Closed")
                        {
                            <span class="badge bg-secondary">Closed</span>
                        }
                        else if (Model.Status == "In Progress")
                        {
                            <span class="badge bg-primary">In Progress</span>
                        }
                        else if (Model.Status == "Under Review")
                        {
                            <span class="badge bg-warning text-dark">Under Review</span>
                        }
                        else
                        {
                            <span class="badge bg-success">@Model.Status</span>
                        }
                    </p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Date Created</strong>
                    <p class="text-muted">
                        @Model.DateCreated.ToString("dd/MM/yyyy HH:mm")
                    </p>
                </div>

            </div>

            <hr />

            <!-- Actions -->
            <div class="d-flex gap-2 mt-4">

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn text-white"
                   style="background-color: #d4a72c;">

                    <i class="bi bi-pencil-square me-1"></i>
                    Edit Investigation
                </a>

                <a asp-controller="Evidences"
                asp-action="ByInvestigation"
                asp-route-investigationId="@Model.Id"
                class="btn text-white"
                style="background-color: #102b4e;">
                <i class="bi bi-folder2-open me-1"></i>
                View Related Evidence
            </a>
                 <a asp-controller="Witnesses"
                 asp-action="ByInvestigation"
                 asp-route-investigationId="@Model.Id"
                 class="btn text-white"
                 style="background-color: #183f6d;">
                 <i class="bi bi-people-fill me-1"></i>
                 View Related Witnesses
             </a>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Back to Investigations
                </a>

            </div>

        </div>

        <div class="card-footer text-muted">
            Police Investigation Case Management System
        </div>

    </div>

</div>
