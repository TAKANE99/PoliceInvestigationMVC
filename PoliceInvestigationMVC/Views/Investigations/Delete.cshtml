@model PoliceInvestigationMVC.Models.Investigation

@{
    ViewData["Title"] = "Delete Investigation";
}

<div class="container mt-4 mb-5">
    <div class="card shadow-sm border-0">

        <div class="card-header text-white"
     style="background-color: #102b4e; border-bottom: 5px solid #d4a72c;">

    <h2 class="mb-2 fw-bold"
        style="color: #ffffff !important;">
        Delete Investigation
    </h2>

    <p class="mb-0" style="color: #ffffff;">
        South African Police Service - Case Management
    </p>

</div>

        <div class="card-body p-4">

            <div class="alert alert-danger">
                <strong>Warning!</strong>
                Are you sure you want to delete this investigation?
                This action cannot be undone.
            </div>

            <h4 style="color: #102b4e;">Case Information</h4>
            <hr />

            <div class="row">
                <div class="col-md-6 mb-3">
                    <strong>Case Number:</strong>
                    <div>@Model.CaseNumber</div>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Complainant:</strong>
                    <div>@Model.Complainant</div>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Crime Category:</strong>
                    <div>@Model.CrimeCategory</div>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Investigation Title:</strong>
                    <div>@Model.Title</div>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Case Type:</strong>
                    <div>@Model.CaseType</div>
                </div>

                <div class="col-12 mb-3">
                    <strong>Investigation Description:</strong>
                    <div>@Model.Description</div>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Case Status:</strong>
                    <div>@Model.Status</div>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Priority:</strong>
                    <div>@Model.Priority</div>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Investigating Officer:</strong>
                    <div>@(Model.InvestigatingOfficer?.Name ?? "Not assigned")</div>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Date Created:</strong>
                    <div>@Model.DateCreated.ToString("dd/MM/yyyy")</div>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Case Review:</strong>
                    <div>@(Model.IsReviewed ? "Reviewed" : "Not Reviewed")</div>
                </div>
            </div>

            <hr />

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />

                <button type="submit" class="btn btn-danger">
                    Confirm Delete
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary ms-2">
                    Back to Investigations
                </a>
            </form>

        </div>
    </div>
</div>
