@model IEnumerable<PoliceInvestigationMVC.Models.Investigation>

@{
    ViewData["Title"] = "Investigation Management";
}

<div class="container-fluid mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 style="color: #102b4e; font-weight: 700;">
                Investigation Management
            </h2>
            <p class="text-muted mb-0">
                Manage and monitor registered police investigations.
            </p>
        </div>

        @if (User.IsInRole("Administrator"))
        {
            <a asp-action="Create"
            class="btn text-white"
            style="background-color: #102b4e;">
                + Register New Investigation
            </a>
        }

    </div>

    <div class="card shadow-sm border-0"
         style="border-top: 4px solid #d4a72c !important;">

        <div class="card-body p-4">
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show"
                role="alert">
                <strong>Deletion Restricted!</strong>
                @TempData["ErrorMessage"]

                <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
                </div>
            }
            <div class="row mb-4">
                <div class="col-md-5 ms-auto">
                    <input type="text"
                           id="investigationSearch"
                           class="form-control"
                           placeholder="Search by case number, CAS number, complainant, category or officer..." />
                </div>
            </div>

            <div class="table-responsive">

                <table class="table table-hover align-middle"
                       id="investigationsTable">

                    <thead style="background-color: #102b4e; color: white;">
                        <tr>
                            <th>Case Number</th>
                            <th>Crime Category</th>
                            <th>Investigation Title</th>
                            <th>Status</th>
                            <th>Priority</th>
                            <th>Investigating Officer</th>
                            <th>Date Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    @item.CaseNumber
                                </td>

                                <td>
                                    @item.CrimeCategory
                                </td>

                                <td>
                                    @item.Title
                                </td>

                                <td>
                                    @if (item.Status == "Open")
                                    {
                                        <span class="badge bg-success">Open</span>
                                    }
                                    else if (item.Status == "Closed")
                                    {
                                        <span class="badge bg-secondary">Closed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            @item.Status
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (item.Priority == "Critical")
                                    {
                                        <span class="badge bg-danger">Critical</span>
                                    }
                                    else if (item.Priority == "High")
                                    {
                                        <span class="badge bg-warning text-dark">High</span>
                                    }
                                    else if (item.Priority == "Medium")
                                    {
                                        <span class="badge bg-info text-dark">Medium</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @item.Priority
                                        </span>
                                    }
                                </td>

                                <td>
                                    @(item.InvestigatingOfficer?.Name ?? "Not assigned")
                                </td>

                                <td>
                                    @item.DateCreated.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    <div class="d-flex gap-2">

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm text-white"
                                           style="background-color: #d4a72c;">
                                            Edit
                                        </a>

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Details
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

                <div id="noResults"
                     class="alert alert-info text-center"
                     style="display: none;">
                    No investigations match your search.
                </div>

            </div>
        </div>
    </div>

    <div class="text-muted mt-3">
        Police Investigation Case Management System
    </div>

</div>

@section Scripts {
    <script>
        document.getElementById("investigationSearch")
            .addEventListener("keyup", function () {

                var searchValue = this.value.toLowerCase();
                var rows = document.querySelectorAll(
                    "#investigationsTable tbody tr"
                );

                var visibleCount = 0;

                rows.forEach(function (row) {
                    var rowText = row.innerText.toLowerCase();

                    if (rowText.includes(searchValue)) {
                        row.style.display = "";
                        visibleCount++;
                    } else {
                        row.style.display = "none";
                    }
                });

                document.getElementById("noResults").style.display =
                    visibleCount === 0 ? "block" : "none";
            });
    </script>
}
